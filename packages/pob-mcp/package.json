{
  "name": "pob-mcp-server",
  "version": "1.0.1",
  "description": "MCP server for Path of Building integration",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\" && tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:smoke": "node tests/smoke/bridge.mjs && node tests/smoke/state-truthfulness.mjs",
    "test:smoke:offline": "node tests/smoke/state-truthfulness.mjs",
    "test:smoke:trade": "node tests/smoke/trade-mcp.mjs",
    "test:smoke:snapshot-cost": "node tests/smoke/snapshot-cost-live.mjs",
    "test:smoke:source-comparable": "node tests/smoke/source-comparable-live.mjs",
    "test:smoke:build-info": "luajit tests/smoke/build-info-absent-tree.lua",
    "test:smoke:currency-reference": "node tests/smoke/currency-reference-live.mjs",
    "test:smoke:trade-preview": "node tests/smoke/trade-preview-live.mjs",
    "test:smoke:cluster-trade": "node tests/smoke/cluster-trade-live.mjs",
    "test:smoke:upstream-tree": "node tests/smoke/upstream-tree-live.mjs",
    "test:smoke:truthfulness": "node tests/smoke/state-truthfulness.mjs",
    "test:smoke:foundation": "node scripts/smoke-suite.mjs foundation",
    "test:smoke:requirements": "node tests/smoke/foundation-requirements.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bottleneck": "^2.19.5",
    "chokidar": "^4.0.3",
    "fast-xml-parser": "^5.12.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11"
  }
}
